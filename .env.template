# Ranaka Backend - Environment Configuration Template
# Copy this file to .env or use these variables in your deployment

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ranaka_test_db
DB_USERNAME=ranaka_user
DB_PASSWORD=your_secure_password_here

# ============================================================
# SERVER CONFIGURATION
# ============================================================
SERVER_PORT=10000

# ============================================================
# JWT SECURITY
# ============================================================
# Use a strong base64-encoded secret, for example: openssl rand -base64 64
JWT_SECRET=your_base64_jwt_secret_change_in_production

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Generate an App Password
# 3. Use the app password below (not your regular Gmail password)
#
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password-16-chars

# For Office 365:
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@company.com
# MAIL_PASSWORD=your-password

# For Custom SMTP Server:
# MAIL_HOST=mail.yourdomain.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@yourdomain.com
# MAIL_PASSWORD=your-password

# Default configuration (update with your actual values)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ============================================================
# APPLICATION PROFILES (for local/dev/prod configurations)
# ============================================================
# Uncomment one of the following based on your environment
# SPRING_PROFILES_ACTIVE=local
# SPRING_PROFILES_ACTIVE=dev
# SPRING_PROFILES_ACTIVE=prod

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# LOG_LEVEL=INFO
# Spring JPA SQL logging (set to DEBUG to see SQL queries)
# SPRING_JPA_SHOW_SQL=false

# ============================================================
# NOTES FOR DEPLOYMENT
# ============================================================
# 1. Database must exist before application starts.
#    Render Postgres provides DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, and DB_PASSWORD values.
#
# 2. For Gmail SMTP:
#    - Enable 2FA on Gmail account
#    - Generate App Password (not regular password)
#    - App Passwords are 16 characters with spaces removed
#
# 3. For secure password storage:
#    - Use environment variables instead of .env file in production
#    - Use secrets management (AWS Secrets Manager, Vault, etc.)
#    - Never commit sensitive values to version control
#
# 4. All passwords should:
#    - Be at least 12 characters long
#    - Include upper/lowercase, numbers, and special characters
#    - Be different from other systems
#
# 5. Test email sending:
#    - Check application logs for email delivery status
#    - Verify SMTP credentials with a test email
#    - Check spam folder if emails not received
